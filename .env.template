# Environment Configuration for Genetic Coil Arena
# Copy this file to .env and customize for your environment

# Security Configuration
SECRET_KEY=your-secret-key-here-use-at-least-32-characters
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password_here
DEFAULT_RESEARCHER_PASSWORD=your_secure_researcher_password_here

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Database Configuration
DATABASE_URL=sqlite:///./genetic_coil_arena.db

# Server Configuration
HOST=localhost
PORT=8000
LOG_LEVEL=info

# Security Middleware Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=300
MAX_BODY_SIZE=10485760

# Development/Production Mode
ENVIRONMENT=development

# Optional: External Services
# REDIS_URL=redis://localhost:6379
# POSTGRESQL_URL=postgresql://user:password@localhost/genetic_coil_arena
