{"id": "d019", "text": "search the apple orchard", "expect": "ok", "params": {"behavior": "search_grid", "area": "orchard"}, "tags": ["search_grid", "alias"]}
{"id": "d020", "text": "circle the barn, radius 25 m", "expect": "ok", "params": {"behavior": "perimeter", "area": "barn", "radius_m": 25}, "tags": ["perimeter"]}
{"id": "d021", "text": "guard the east woods", "expect": "ok", "params": {"behavior": "perimeter", "area": "east woods"}, "tags": ["perimeter", "default"]}
{"id": "d022", "text": "patrol around the field to the north at 8 m altitude, radius fifteen metres", "expect": "ok", "params": {"behavior": "perimeter", "area": "north field", "radius_m": 15, "alt_m": 8}, "tags": ["perimeter", "alias"]}
{"id": "d023", "text": "orbit home 20 ft out", "expect": "ok", "params": {"behavior": "perimeter", "area": "home", "radius_m": 6.1}, "tags": ["perimeter", "feet"]}
{"id": "d024", "text": "watch the car park from above, circle it", "expect": "ok", "params": {"behavior": "perimeter", "area": "car park"}, "tags": ["perimeter"]}
{"id": "d025", "text": "follow the guy the camera sees", "expect": "ok", "params": {"behavior": "person_follow"}, "tags": ["person_follow", "default"]}
