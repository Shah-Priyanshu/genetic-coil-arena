{"id": "d016", "text": "search the parking lot at 10 m", "expect": "ok", "params": {"behavior": "search_grid", "area": "car park", "alt_m": 10}, "tags": ["search_grid", "alias"]}
{"id": "d017", "text": "grid search over the old barn, we lost a dog", "expect": "ok", "params": {"behavior": "search_grid", "area": "barn"}, "tags": ["search_grid", "alias"]}
