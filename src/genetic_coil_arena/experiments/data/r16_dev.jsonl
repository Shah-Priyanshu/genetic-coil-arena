{"id": "d027", "text": "follow person with 80% confidence minimum", "expect": "ok", "params": {"behavior": "person_follow", "min_conf": 0.8}, "tags": ["person_follow"]}
{"id": "d028", "text": "tail the hiker at 4 metres distance, altitude 3 m, confidence at least 0.9", "expect": "ok", "params": {"behavior": "person_follow", "distance_m": 4, "alt_m": 3, "min_conf": 0.9}, "tags": ["person_follow"]}
