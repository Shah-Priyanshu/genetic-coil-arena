{"id": "d004", "text": "Swarm, stay put at altitude 8 metres, we are swapping a battery on the ground rig", "expect": "ok", "params": {"behavior": "hover", "alt_m": 8}, "tags": ["hover"]}
{"id": "d005", "text": "form a circle, 3 m apart", "expect": "ok", "params": {"behavior": "formation", "shape": "circle", "spacing_m": 3}, "tags": ["formation"]}
