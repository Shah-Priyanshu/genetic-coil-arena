{"id": "d011", "text": "flock like birds", "expect": "ok", "params": {"behavior": "boids"}, "tags": ["boids", "default"]}
{"id": "d012", "text": "boids mode, cohesion 2, separation 3", "expect": "ok", "params": {"behavior": "boids", "cohesion": 2, "separation": 3}, "tags": ["boids"]}
