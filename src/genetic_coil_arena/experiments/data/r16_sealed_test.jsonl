{"id": "s001", "text": "Swarm hold position.", "expect": "ok", "params": {"behavior": "hover"}, "tags": ["hover"]}
{"id": "s002", "text": "hover at 5 meters, thx", "expect": "ok", "params": {"behavior": "hover", "alt_m": 5}, "tags": ["hover"]}
{"id": "s003", "text": "Could you please keep every drone hovering about 18 m up while we check the map?", "expect": "ok", "params": {"behavior": "hover", "alt_m": 18}, "tags": ["hover"]}
{"id": "s004", "text": "hovr at 10 m", "expect": "ok", "params": {"behavior": "hover", "alt_m": 10}, "tags": ["hover", "typo"]}
{"id": "s005", "text": "freeze in the air where u are", "expect": "ok", "params": {"behavior": "hover"}, "tags": ["hover"]}
{"id": "s006", "text": "Stand by, hover at fifty feet, waiting on the farmer to clear the gate", "expect": "ok", "params": {"behavior": "hover", "alt_m": 15.24}, "tags": ["hover", "feet"]}
{"id": "s007", "text": "hover 1 metre", "expect": "ok", "params": {"behavior": "hover", "alt_m": 1}, "tags": ["hover"]}
{"id": "s008", "text": "all units hold at three metres", "expect": "ok", "params": {"behavior": "hover", "alt_m": 3}, "tags": ["hover"]}
{"id": "s009", "text": "I need them to just float there at 25 m while I look at the telemetry", "expect": "ok", "params": {"behavior": "hover", "alt_m": 25}, "tags": ["hover"]}
{"id": "s010", "text": "Stay in place, 12 ft", "expect": "ok", "params": {"behavior": "hover", "alt_m": 3.66}, "tags": ["hover", "feet"]}
{"id": "s011", "text": "Make a V.", "expect": "ok", "params": {"behavior": "formation", "shape": "v"}, "tags": ["formation"]}
{"id": "s012", "text": "circle formation at 6 m high with 2.5 m spacing", "expect": "ok", "params": {"behavior": "formation", "shape": "circle", "alt_m": 6, "spacing_m": 2.5}, "tags": ["formation"]}
{"id": "s013", "text": "Arrange yourselves in a grid please", "expect": "ok", "params": {"behavior": "formation", "shape": "grid"}, "tags": ["formation"]}
{"id": "s014", "text": "line abreast, spacing four meters", "expect": "ok", "params": {"behavior": "formation", "shape": "line", "spacing_m": 4}, "tags": ["formation"]}
{"id": "s015", "text": "pls make a squar grid, 3 m gap", "expect": "ok", "params": {"behavior": "formation", "shape": "grid", "spacing_m": 3}, "tags": ["formation", "typo"]}
{"id": "s016", "text": "Form up, ten feet between drones, altitude 20 m", "expect": "ok", "params": {"behavior": "formation", "spacing_m": 3.05, "alt_m": 20}, "tags": ["formation", "feet"]}
{"id": "s017", "text": "spread out to 8 m spacing", "expect": "ok", "params": {"behavior": "formation", "spacing_m": 8}, "tags": ["formation"]}
{"id": "s018", "text": "ok team, we want a nice ring for the crowd shot, say 2 metres apart and about 12 m up", "expect": "ok", "params": {"behavior": "formation", "shape": "circle", "spacing_m": 2, "alt_m": 12}, "tags": ["formation"]}
{"id": "s019", "text": "Fly a V shape at fifteen feet altitude", "expect": "ok", "params": {"behavior": "formation", "shape": "v", "alt_m": 4.57}, "tags": ["formation", "feet"]}
{"id": "s020", "text": "ALL UNITS LINE UP NOW, 1 METRE APART", "expect": "ok", "params": {"behavior": "formation", "shape": "line", "spacing_m": 1}, "tags": ["formation"]}
{"id": "s021", "text": "get in formation at 7 m", "expect": "ok", "params": {"behavior": "formation", "alt_m": 7}, "tags": ["formation", "default"]}
{"id": "s022", "text": "tighter formation, i want 0.8 m between neighbours, grid", "expect": "ok", "params": {"behavior": "formation", "shape": "grid", "spacing_m": 0.8}, "tags": ["formation"]}
{"id": "s023", "text": "form a v with two and a half metres spacing", "expect": "ok", "params": {"behavior": "formation", "shape": "v", "spacing_m": 2.5}, "tags": ["formation"]}
{"id": "s024", "text": "Let them flock.", "expect": "ok", "params": {"behavior": "boids"}, "tags": ["boids"]}
{"id": "s025", "text": "free flight like a flock of starlings, cohesion 3", "expect": "ok", "params": {"behavior": "boids", "cohesion": 3}, "tags": ["boids"]}
{"id": "s026", "text": "boids with separation 2.5 and alignment 1.5", "expect": "ok", "params": {"behavior": "boids", "separation": 2.5, "alignment": 1.5}, "tags": ["boids"]}
{"id": "s027", "text": "switch to flocking mode with zero alignment", "expect": "ok", "params": {"behavior": "boids", "alignment": 0}, "tags": ["boids"]}
{"id": "s028", "text": "Please let the swarm move organically as a flock, cohesion at four, separation at one, alignment two.", "expect": "ok", "params": {"behavior": "boids", "cohesion": 4, "separation": 1, "alignment": 2}, "tags": ["boids"]}
{"id": "s029", "text": "boids pls", "expect": "ok", "params": {"behavior": "boids"}, "tags": ["boids"]}
{"id": "s030", "text": "flocking, but keep them apart: separation 5", "expect": "ok", "params": {"behavior": "boids", "separation": 5}, "tags": ["boids"]}
{"id": "s031", "text": "make em swarm like birds, cohesion 0.5", "expect": "ok", "params": {"behavior": "boids", "cohesion": 0.5}, "tags": ["boids"]}
{"id": "s032", "text": "birds mode. alignment 3, cohesion 2", "expect": "ok", "params": {"behavior": "boids", "alignment": 3, "cohesion": 2}, "tags": ["boids"]}
{"id": "s033", "text": "we would like the drones to flock freely around, no particular pattern, separation weight of 3", "expect": "ok", "params": {"behavior": "boids", "separation": 3}, "tags": ["boids"]}
{"id": "s034", "text": "Search the school yard... wait, the schoolyard. yes search it", "expect": "ok", "params": {"behavior": "search_grid", "area": "school"}, "tags": ["search_grid", "alias", "no-fly"]}
{"id": "s035", "text": "lane sweep of the highway at 12 m", "expect": "ok", "params": {"behavior": "search_grid", "area": "highway", "alt_m": 12}, "tags": ["search_grid", "no-fly"]}
{"id": "s036", "text": "Search east woods", "expect": "ok", "params": {"behavior": "search_grid", "area": "east woods"}, "tags": ["search_grid"]}
{"id": "s037", "text": "search the forest at 15 m altitude, a hiker is overdue", "expect": "ok", "params": {"behavior": "search_grid", "area": "east woods", "alt_m": 15}, "tags": ["search_grid", "alias"]}
{"id": "s038", "text": "sweep the area around the launch pad for a dropped phone", "expect": "ok", "params": {"behavior": "search_grid", "area": "home"}, "tags": ["search_grid", "alias"]}
{"id": "s039", "text": "grid search the river bank", "expect": "ok", "params": {"behavior": "search_grid", "area": "river bank"}, "tags": ["search_grid"]}
{"id": "s040", "text": "Scan parking", "expect": "ok", "params": {"behavior": "search_grid", "area": "car park"}, "tags": ["search_grid", "alias"]}
{"id": "s041", "text": "look for people in the orchard, fly at 6 metres", "expect": "ok", "params": {"behavior": "search_grid", "area": "orchard", "alt_m": 6}, "tags": ["search_grid"]}
{"id": "s042", "text": "search the motorway at 20 feet", "expect": "ok", "params": {"behavior": "search_grid", "area": "highway", "alt_m": 6.1}, "tags": ["search_grid", "alias", "feet", "no-fly"]}
{"id": "s043", "text": "could you send the swarm to search the field to the north? low, like 4 m", "expect": "ok", "params": {"behavior": "search_grid", "area": "north field", "alt_m": 4}, "tags": ["search_grid", "alias"]}
{"id": "s044", "text": "serach the barn", "expect": "ok", "params": {"behavior": "search_grid", "area": "barn"}, "tags": ["search_grid", "typo"]}
{"id": "s045", "text": "Combing the old barn and the surroundings please, 8 metres up, lanes", "expect": "ok", "params": {"behavior": "search_grid", "area": "barn", "alt_m": 8}, "tags": ["search_grid", "alias"]}
{"id": "s046", "text": "Circle the school.", "expect": "ok", "params": {"behavior": "perimeter", "area": "school"}, "tags": ["perimeter", "no-fly"]}
{"id": "s047", "text": "guard the road, radius 30 m", "expect": "ok", "params": {"behavior": "perimeter", "area": "highway", "radius_m": 30}, "tags": ["perimeter", "alias", "no-fly"]}
{"id": "s048", "text": "we've got a missing hiker, last seen near the old barn, can you circle it at 20 m out", "expect": "ok", "params": {"behavior": "perimeter", "area": "barn", "radius_m": 20}, "tags": ["perimeter", "alias"]}
{"id": "s049", "text": "secure the perimeter of the apple orchard at 12 m altitude", "expect": "ok", "params": {"behavior": "perimeter", "area": "orchard", "alt_m": 12}, "tags": ["perimeter", "alias"]}
{"id": "s050", "text": "orbit the car park radius 40 ft", "expect": "ok", "params": {"behavior": "perimeter", "area": "car park", "radius_m": 12.19}, "tags": ["perimeter", "feet"]}
{"id": "s051", "text": "patrol around the riverbank, radius 5 m, height 4 m", "expect": "ok", "params": {"behavior": "perimeter", "area": "river bank", "radius_m": 5, "alt_m": 4}, "tags": ["perimeter", "alias"]}
{"id": "s052", "text": "Watch the woods, ring of thirty metres", "expect": "ok", "params": {"behavior": "perimeter", "area": "east woods", "radius_m": 30}, "tags": ["perimeter", "alias"]}
{"id": "s053", "text": "perimeter north field", "expect": "ok", "params": {"behavior": "perimeter", "area": "north field"}, "tags": ["perimeter"]}
{"id": "s054", "text": "circel the base at 10 m up", "expect": "ok", "params": {"behavior": "perimeter", "area": "home", "alt_m": 10}, "tags": ["perimeter", "typo", "alias"]}
{"id": "s055", "text": "fly a circle around here with a radius of 8 metres", "expect": "ok", "params": {"behavior": "perimeter", "area": "home", "radius_m": 8}, "tags": ["perimeter", "alias"]}
{"id": "s056", "text": "keep watch on the parking lot, please orbit it at radius 15 and altitude 9", "expect": "ok", "params": {"behavior": "perimeter", "area": "car park", "radius_m": 15, "alt_m": 9}, "tags": ["perimeter", "alias"]}
{"id": "s057", "text": "guard barn 100 m radius", "expect": "ok", "params": {"behavior": "perimeter", "area": "barn", "radius_m": 100}, "tags": ["perimeter"]}
{"id": "s058", "text": "Follow the person.", "expect": "ok", "params": {"behavior": "person_follow"}, "tags": ["person_follow"]}
{"id": "s059", "text": "follow him but keep 6 m away", "expect": "ok", "params": {"behavior": "person_follow", "distance_m": 6}, "tags": ["person_follow"]}
{"id": "s060", "text": "shadow the detected person at two metres, altitude 4", "expect": "ok", "params": {"behavior": "person_follow", "distance_m": 2, "alt_m": 4}, "tags": ["person_follow"]}
{"id": "s061", "text": "track target only if confidence is above 60%", "expect": "ok", "params": {"behavior": "person_follow", "min_conf": 0.6}, "tags": ["person_follow"]}
{"id": "s062", "text": "Follow the walker, hold 10 feet back, 50 percent confidence is fine", "expect": "ok", "params": {"behavior": "person_follow", "distance_m": 3.05, "min_conf": 0.5}, "tags": ["person_follow", "feet"]}
{"id": "s063", "text": "folow the person pls", "expect": "ok", "params": {"behavior": "person_follow"}, "tags": ["person_follow", "typo"]}
{"id": "s064", "text": "stick with whoever the scout cam picks up, at 8 m distance and 5 m altitude", "expect": "ok", "params": {"behavior": "person_follow", "distance_m": 8, "alt_m": 5}, "tags": ["person_follow"]}
{"id": "s065", "text": "be careful, I want only solid detections: min confidence 95%, follow the person", "expect": "ok", "params": {"behavior": "person_follow", "min_conf": 0.95}, "tags": ["person_follow"]}
{"id": "s066", "text": "tail that person, 1.5 m", "expect": "ok", "params": {"behavior": "person_follow", "distance_m": 1.5}, "tags": ["person_follow"]}
{"id": "s067", "text": "Person follow, altitude 3 metres.", "expect": "ok", "params": {"behavior": "person_follow", "alt_m": 3}, "tags": ["person_follow"]}
{"id": "s068", "text": "go after the person the camera found, keep 9 metres behind and detection threshold 0.4", "expect": "ok", "params": {"behavior": "person_follow", "distance_m": 9, "min_conf": 0.4}, "tags": ["person_follow"]}
